# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will never be committed.
#
# SUBCONSCIOUS reads these variables at startup.  You can also set them as
# Environment= directives in the systemd unit instead of using a file.
#
# Effective memory stack in SUBCONSCIOUS:
#   L0   - mempalace    - model identity.txt                - Always loaded
#   L1   - mempalace    - Essential Story (wake-up context) - Always loaded
#   L1.5 - subconscious - KG recall + RAG sidecar           - Always loaded (unless SUBCONSCIOUS_LAYER_15_ENABLED=false)
#   L2   - mempalace    - Room Recall (filtered retrieval)  - When topic comes up
#   L3   - mempalace    - Deep Search (full semantic query) - When explicitly asked

# ── Ollama ────────────────────────────────────────────────────────────────────────
OLLAMA_API=http://127.0.0.1:11434

# ── MCP servers ───────────────────────────────────────────────────────────────────
# Register any number of MCP servers with SUBCONSCIOUS_MCP_STDIO_<NAME>=<shell command>.
# SUBCONSCIOUS discovers all SUBCONSCIOUS_MCP_HTTP_* variables automatically at startup.
#
# Replace /path/to/venv/bin/python with the actual path to your venv Python.

SUBCONSCIOUS_MCP_STDIO_MEMPALACE=/path/to/venv/bin/python -m mempalace.mcp_server

# ── MemPalace ──────────────────────────────────────────────────────────────────────
# Path to the palace directory (wings/rooms hierarchy).
MEMPALACE_PALACE_PATH=/var/lib/mempalace

# Path to knowledge_graph.sqlite3.  Set this explicitly when the KG file
# lives in a different directory than the palace.
# Default: ~/.mempalace/knowledge_graph.sqlite3
# MEMPALACE_KG_PATH=/path/to/.mempalace/knowledge_graph.sqlite3

# Uncomment and change to true to enable filtering of the list of tools available to the model.
# SUBCONSCIOUS_TOOLS_FILTER=false

# Comma-separated list of tools to expose to the model.
# Uncomment and edit to restrict or extend the default set.
# SUBCONSCIOUS_TOOLS_ALLOWED=mempalace_status,mempalace_search,mempalace_add_drawer,mempalace_kg_query,mempalace_kg_add

# ── Identity ──────────────────────────────────────────────────────────────────
# Operator content, not repository content. Seeded from a generic default
# on first start if the file is missing; never overwritten afterwards.
# Edit the file in place to describe this installation.
# SUBCONSCIOUS_IDENTITY_PATH=/var/lib/subconscious/identity.txt

# ── Memory layer toggles ──────────────────────────────────────────────────────────
# Set to false to disable the corresponding subconscious-owned memory layer.
# Useful when the system prompt is too large and you want to shed tokens.
#
# L1.5: request-scoped KG recall + RAG sidecar.
# SUBCONSCIOUS_LAYER_15_ENABLED=true

# ── Event ledger ──────────────────────────────────────────────────────────────
# SQLite store for queryable event history. Distinct from the append-only
# events.jsonl audit trail.
# SUBCONSCIOUS_EVENTS_DB_PATH=/var/lib/subconscious/events.sqlite3

# Default user id when no X-OpenWebUI-User-Email header is present.
# Empty means "no user context" - events are still recorded, just without
# a user_id. Set this on single-user installs to enable cross-channel
# identity for non-WebUI sources.
# SUBCONSCIOUS_USER_DEFAULT_ID=

# ── Sampling (optional) ───────────────────────────────────────────────────────────────
# SUBCONSCIOUS_THINKING=false
# SUBCONSCIOUS_TEMPERATURE=0.3
# SUBCONSCIOUS_TOP_P=0.9
# SUBCONSCIOUS_TOP_K=40
# SUBCONSCIOUS_REPEAT_PENALTY=1.05
# SUBCONSCIOUS_NUM_CTX=8192
# SUBCONSCIOUS_NUM_PREDICT=768

# ── Truncation limits ────────────────────────────────────────────────────
# Character limits (not tokens) applied before tool results and text
# snippets are fed back to the model. Bounds prefill on CPU-only hosts.

SUBCONSCIOUS_BG_TOOL_RESULT_MAX_CHARS=3000
SUBCONSCIOUS_BG_EXPLORATORY_SEED_MAX_CHARS=4000
SUBCONSCIOUS_BG_OBSERVATION_SNIPPET_CHARS=250
SUBCONSCIOUS_BG_RECENT_OBSERVATIONS_LIMIT=12
SUBCONSCIOUS_CHAT_TOOL_RESULT_MAX_CHARS=8000
SUBCONSCIOUS_MEMORY_KG_SNIPPET_LIMIT=60

# ── History window ────────────────────────────────────────────────────────────────
# Number of user+assistant pairs to keep when sending history to the backend.
# Increase when using a model with a large context window (e.g. DeepSeek 1M ctx).
# SUBCONSCIOUS_MAX_HISTORY_TURNS=20

# ── Session / summaries ─────────────────────────────────────────────────────────────
# Directory where per-chat session JSON files are stored.
# SUBCONSCIOUS_SESSION_DIR=/var/lib/subconscious/sessions

# ── OpenRouter (optional cloud backend) ───────────────────────────────────────────
# Prefix model names with "or:" to route them to OpenRouter instead of Ollama.
# Example: model=or:mistralai/mistral-7b-instruct:free
#
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_PREFIX=or:

# ── External RAG store (L1.5) ─────────────────────────────────────────────────────
# subconscious-owned SQLite store, completely separate from mempalace.
# Conversation turns are embedded and retrieved by cosine similarity.
#
# Before enabling, pull the embed model:
#   ollama pull nomic-embed-text
#
# SUBCONSCIOUS_RAG_DB_PATH=/var/lib/subconscious/rag.sqlite3
#
# Embed backend: "ollama" (default) or "onnx" (local ONNX encoder).
# SUBCONSCIOUS_RAG_BACKEND=ollama
#
# Model name passed to the embed backend.
# SUBCONSCIOUS_RAG_EMBED_MODEL=nomic-embed-text
#
#
# Number of chunks to return per retrieval.
# SUBCONSCIOUS_RAG_TOP_K=4
#
# Maximum characters per indexed chunk (user+assistant combined).
# SUBCONSCIOUS_RAG_MAX_CHARS_PER_CHUNK=4000
#
# Minimum cosine similarity score to include a chunk (0 = identical, 1 = orthogonal).
# Lower values return more (noisier) results.
# SUBCONSCIOUS_RAG_MIN_SCORE=0.25

# ── Background thinking (subconscious) ──────────────────────────────────────
# Disabled by default. Enable per-installation to run a periodic background
# worker that observes and proposes, but never writes to canonical memory.
#
# State lives in SUBCONSCIOUS_BG_STATE_DIR (journal.jsonl + tick.lock).
# The /api/tick endpoint is protected by SUBCONSCIOUS_BG_TOKEN, separate from
# SUBCONSCIOUS_EVENT_TOKEN - different triggers, different secrets.
SUBCONSCIOUS_BG_ENABLED=false
SUBCONSCIOUS_BG_TOKEN=
SUBCONSCIOUS_BG_STATE_DIR=/var/lib/subconscious/bg
SUBCONSCIOUS_BG_SESSION_ID=background
SUBCONSCIOUS_BG_MODEL=qwen3:8b
SUBCONSCIOUS_BG_NUM_PREDICT=256
SUBCONSCIOUS_BG_MAX_TOOL_ROUNDS=5
SUBCONSCIOUS_BG_TOOLS_ALLOWED=mempalace_search,mempalace_kg_query,mempalace_status,mempalace_kg_timeline,meta_list_servers,meta_search,meta_call,meta_describe_tool,alerts_list,alerts_summary,monitor_query,notes_search

# ── Background thinking - phases (PR C) ─────────────────────────────────────
# Per-phase model routing. Empty value → falls back to SUBCONSCIOUS_BG_MODEL.
SUBCONSCIOUS_BG_MODEL_PLANNER=
SUBCONSCIOUS_BG_MODEL_EXECUTOR=
SUBCONSCIOUS_BG_MODEL_REFLECTOR=
SUBCONSCIOUS_BG_MODEL_THINK=

# Per-phase timeouts (seconds). Executor gets more room for its tool loop.
SUBCONSCIOUS_BG_PHASE_TIMEOUT=600
SUBCONSCIOUS_BG_PHASE_TIMEOUT_EXECUTOR=900
SUBCONSCIOUS_BG_TICK_TIMEOUT=2700

# Goal ledger limits.
SUBCONSCIOUS_BG_MAX_ATTEMPTS_PER_GOAL=3
SUBCONSCIOUS_BG_MAX_OPEN_GOALS=5

# Exploratory goals (created when Planner returns skip).
SUBCONSCIOUS_BG_EXPLORATORY_PER_DAY=3
SUBCONSCIOUS_BG_EXPLORATORY_TTL_HOURS=24

# Daily budgets. 0 = no limit.
SUBCONSCIOUS_BG_DAILY_TOKEN_BUDGET=0
SUBCONSCIOUS_BG_DAILY_TIME_BUDGET_SEC=0

SUBCONSCIOUS_BG_MAX_NEW_GOALS_PER_DAY=3
SUBCONSCIOUS_BG_JOURNAL_MAX_MB=10
SUBCONSCIOUS_BG_JOURNAL_KEEP=5

# ── Cloud model budget + soft degrade ────────────────────────────────────
# Any model whose name starts with one of these prefixes is "cloud" for
# the purpose of the cloud daily token budget. Tokens from local models
# do not count toward this limit.
SUBCONSCIOUS_BG_CLOUD_PREFIXES=deepseek/,or/

# Daily cloud token budget (across planner/executor/reflector). 0 = unlimited.
# When the limit is reached, cloud models are replaced with SUBCONSCIOUS_BG_DEGRADE_MODEL
# for the rest of the day (soft degrade). New day resets the counter.
SUBCONSCIOUS_BG_CLOUD_DAILY_TOKEN_BUDGET=0

# Fallback model used when cloud budget is exhausted. If empty,
# SUBCONSCIOUS_BG_MODEL is used. Should point to a local model.
SUBCONSCIOUS_BG_DEGRADE_MODEL=qwen3.5:9b

# Wake-up block for background phases: none | identity | full.
#   "none"     - no wake-up, only phase instructions (recommended)
#   "identity" - identity.txt only, no KG snippet
#   "full"     - full wake-up (identity + KG) - same as chat
#
# Per-phase overrides. Leave empty to inherit BG_WAKEUP_MODE.
SUBCONSCIOUS_BG_WAKEUP_MODE=none
# SUBCONSCIOUS_BG_WAKEUP_MODE_PLANNER=
# SUBCONSCIOUS_BG_WAKEUP_MODE_EXECUTOR=
# SUBCONSCIOUS_BG_WAKEUP_MODE_REFLECTOR=
# SUBCONSCIOUS_BG_WAKEUP_MODE_EXPLORATORY=
